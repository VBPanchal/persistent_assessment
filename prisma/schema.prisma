generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  provider    String
  status      String
  riskScore   Float
  explanation String
  amount      Float
  email       String
  createdAt   DateTime @default(now())
}

model Subscription {
  id                  String   @id @default(cuid())
  donorId             String   @unique
  email               String
  amount              Float
  currency            String
  interval            String
  campaignDescription String
  tags                String[]
  summary             String
  lastCharged         DateTime @default(now())
  createdAt           DateTime @default(now())
}
